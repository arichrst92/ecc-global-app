{
  "expo": {
    "name": "Els App",
    "slug": "ecc-mobile-app",
    "version": "2.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/ecc-icon-ios.png",
    "scheme": "ecc",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/ecc-icon-circle.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "idea.eccchurch.global",
      "icon": "./assets/images/ecc-icon-ios.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Els App membutuhkan akses kamera untuk scan QR jemaat saat check-in ibadah, event, dan menambah anggota keluarga/group.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["ecc"]
          }
        ]
      },
      "associatedDomains": [
        "applinks:eccchurch.global",
        "applinks:www.eccchurch.global"
      ]
    },
    "android": {
      "package": "idea.eccchurch.global",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ecc-icon-adaptive.png",
        "backgroundColor": "#F97316"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ecc",
              "host": "auth"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/ibadah"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/content"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/renungan"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/news"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/ibadah"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/content"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/renungan"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/news"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Els App butuh akses kamera untuk scan QR jemaat.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Els App membutuhkan akses galeri foto untuk mengunggah bukti pembayaran event dan foto profil.",
          "cameraPermission": "Els App membutuhkan akses kamera untuk mengambil foto bukti pembayaran dan foto profil."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.eccchurch.global",
      "apiPortDev": 4100,
      "router": {},
      "eas": {
        "projectId": "936cd3ec-baf0-4b3a-9635-64d7b2167af6"
      }
    },
    "owner": "arichrst92",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/936cd3ec-baf0-4b3a-9635-64d7b2167af6"
    }
  }
}
