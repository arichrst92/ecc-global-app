{
  "expo": {
    "name": "Els App",
    "slug": "ecc-mobile-app",
    "version": "2.4.4",
    "orientation": "portrait",
    "icon": "./assets/images/ecc-icon-ios.png",
    "scheme": "ecc",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/ecc-icon-circle.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "idea.eccchurch.global",
      "icon": "./assets/images/ecc-icon-ios.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Els App membutuhkan akses kamera untuk scan QR jemaat saat check-in ibadah, event, dan menambah anggota keluarga/group.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "ecc"
            ]
          }
        ],
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "associatedDomains": [
        "applinks:eccchurch.global",
        "applinks:www.eccchurch.global"
      ]
    },
    "android": {
      "package": "idea.eccchurch.global",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ecc-icon-adaptive.png",
        "backgroundColor": "#F97316"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ecc",
              "host": "auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/ibadah"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/content"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/renungan"
            },
            {
              "scheme": "https",
              "host": "eccchurch.global",
              "pathPrefix": "/news"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/ibadah"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/content"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/renungan"
            },
            {
              "scheme": "https",
              "host": "www.eccchurch.global",
              "pathPrefix": "/news"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Els App membutuhkan akses kamera untuk scan QR jemaat saat check-in ibadah, event, dan menambah anggota keluarga/group.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Els App membutuhkan akses galeri foto untuk mengunggah foto profil, bukti pembayaran event, foto group, dan foto usaha Anda di Local Market.",
          "cameraPermission": "Els App membutuhkan akses kamera untuk scan QR jemaat saat check-in ibadah, event, dan menambah anggota keluarga/group."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class com.google.android.gms.** { *; }\n-keep class expo.modules.** { *; }\n-keepattributes *Annotation*\n-keepattributes Signature\n-keepattributes InnerClasses\n-keepattributes EnclosingMethod"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Els App menggunakan lokasi Anda untuk mencari homecell terdekat dan memastikan Anda berada di lokasi ibadah atau event saat self check-in."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Els App membutuhkan akses kalender untuk menyimpan jadwal ibadah dan event dari tiket Anda.",
          "remindersPermission": "Els App tidak membaca pengingat Anda; izin ini hanya disediakan oleh modul kalender untuk menyimpan jadwal ibadah dan event."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Els App membutuhkan akses foto untuk menyimpan kartu share ke galeri Anda.",
          "savePhotosPermission": "Els App menyimpan kartu share (ayat, renungan, event, Bible 365) ke galeri Anda.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.eccchurch.global",
      "apiPortDev": 4100,
      "router": {},
      "eas": {
        "projectId": "936cd3ec-baf0-4b3a-9635-64d7b2167af6"
      }
    },
    "owner": "arichrst92",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/936cd3ec-baf0-4b3a-9635-64d7b2167af6"
    }
  }
}
