+  private fun applySessionMetadata(player: AudioPlayer, metadata: Metadata?) {
+    if (metadata == null) return
+    try {
+      val exo = player.ref
+      val item = exo.currentMediaItem ?: return
+      val md = MediaMetadata.Builder()
+        .setTitle(metadata.title)
+        .setDisplayTitle(metadata.title)
+        .setArtist(metadata.artist)
+        .setAlbumTitle(metadata.albumTitle)
+        .setArtworkUri(metadata.artworkUrl?.let { Uri.parse(it.toString()) })
+        .build()
+      if (item.mediaMetadata == md) return
+      exo.replaceMediaItem(exo.currentMediaItemIndex, item.buildUpon().setMediaMetadata(md).build())
+    } catch (_: Throwable) {
+      // Abaikan — notifikasi tetap tampil dengan teks dari currentMetadata.
